{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunedtensor.com/schemas/pipeline-v1.schema.json",
  "title": "Tuned Tensor Pipeline v1",
  "description": "Portable ordered pipeline document. Semantic dependency and placement validation is performed by parsePipeline().",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "steps"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "target": { "$ref": "#/$defs/target" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "target": {
      "type": "string",
      "enum": ["local", "cloud"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine"],
      "properties": {
        "engine": { "const": "foundation" }
      }
    },
    "stepId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_]*$"
        }
      }
    },
    "trainStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uses"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "uses": { "const": "train" },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "evaluateStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uses", "with"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "uses": { "const": "evaluate" },
        "target": { "$ref": "#/$defs/target" },
        "with": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model"],
          "properties": {
            "model": {
              "oneOf": [
                { "const": "base" },
                { "$ref": "#/$defs/artifactReference" }
              ]
            },
            "evaluator": {
              "enum": ["behavior", "bpb", "chat", "inference"],
              "default": "behavior"
            }
          }
        }
      }
    },
    "compareStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uses", "with"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "uses": { "const": "compare" },
        "target": { "$ref": "#/$defs/target" },
        "with": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": { "$ref": "#/$defs/artifactReference" },
            "after": { "$ref": "#/$defs/artifactReference" }
          }
        }
      }
    },
    "tokenizeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uses"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "uses": { "const": "tokenize" },
        "target": { "$ref": "#/$defs/target" },
        "with": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vocabSize": { "type": "integer", "minimum": 64, "maximum": 65536 },
            "maxChars": { "type": "integer", "minimum": 1000, "maximum": 2000000000 }
          }
        }
      }
    },
    "pretrainStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uses", "with"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "uses": { "const": "pretrain" },
        "target": { "$ref": "#/$defs/target" },
        "with": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokenizer"],
          "properties": {
            "tokenizer": { "$ref": "#/$defs/artifactReference" },
            "depth": { "type": "integer", "minimum": 1, "maximum": 64 },
            "steps": { "type": "integer", "minimum": 1, "maximum": 10000000 },
            "batchSize": { "type": "integer", "minimum": 1, "maximum": 1024 },
            "sequenceLength": { "type": "integer", "minimum": 16, "maximum": 8192 },
            "nprocPerNode": { "type": "integer", "minimum": 1, "maximum": 16 }
          }
        }
      }
    },
    "finetuneStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uses", "with"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "uses": { "const": "finetune" },
        "target": { "$ref": "#/$defs/target" },
        "with": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model"],
          "properties": {
            "model": { "$ref": "#/$defs/artifactReference" },
            "steps": { "type": "integer", "minimum": 1, "maximum": 10000000 },
            "batchSize": { "type": "integer", "minimum": 1, "maximum": 1024 }
          }
        }
      }
    },
    "rlStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uses", "with"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "uses": { "const": "rl" },
        "target": { "$ref": "#/$defs/target" },
        "with": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model"],
          "properties": {
            "model": { "$ref": "#/$defs/artifactReference" },
            "steps": { "type": "integer", "minimum": 1, "maximum": 10000000 }
          }
        }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/trainStep" },
        { "$ref": "#/$defs/evaluateStep" },
        { "$ref": "#/$defs/compareStep" },
        { "$ref": "#/$defs/tokenizeStep" },
        { "$ref": "#/$defs/pretrainStep" },
        { "$ref": "#/$defs/finetuneStep" },
        { "$ref": "#/$defs/rlStep" }
      ]
    }
  }
}

{
  "name": "@tuned-tensor/pipeline-contract",
  "version": "1.0.0",
  "description": "Portable ordered Pipeline v1 contract for Tuned Tensor local and cloud runtimes",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema": "./schema/pipeline-v1.schema.json",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "schema",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:lint": "publint && attw --pack . --profile node16",
    "pack:check": "npm pack --dry-run --json",
    "pack:test": "npm run build && node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "tuned-tensor",
    "pipeline",
    "workflow",
    "schema",
    "fine-tuning"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunedtensor/pipeline-contract.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.2.0",
    "ajv": "^8.17.1",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  }
}
